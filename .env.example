DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaultfoundry

# Used by docker-compose.yml to configure the Postgres container and to build
# the app container's DATABASE_URL (which overrides the value above when
# running via `docker compose up` — inside that network Postgres is reached
# by service name, not localhost). Change the password for any real deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vaultfoundry

STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vaultfoundry-assets
R2_PUBLIC_BASE_URL=
DELIVERY_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# From the Resend dashboard: Webhooks > add endpoint pointing at
# https://<your-domain>/api/webhooks/resend, subscribed to the email.*
# events. Copy the signing secret it gives you (starts with whsec_) here.
# Enables open/click/bounce tracking; sending still works without it.
RESEND_WEBHOOK_SECRET=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
